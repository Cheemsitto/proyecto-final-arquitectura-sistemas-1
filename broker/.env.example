# Puerto del broker (único punto de entrada para Postman)
PORT=8000

# Base de datos propia del broker (tabla usuarios)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=broker_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Firma de los tokens JWT: mínimo 32 caracteres
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRA_MIN=60

# Usuario que se crea al iniciar si no existe
ADMIN_USUARIO=admin
ADMIN_PASSWORD=Admin123*

# Servicios a los que reenvía
PRODUCTOS_URL=http://localhost:3001
PEDIDOS_URL=http://localhost:8082
# Deben ser iguales a SERVICE_KEY de cada servicio
PRODUCTOS_SERVICE_KEY=cambia-esta-clave-interna
PEDIDOS_SERVICE_KEY=cambia-esta-clave-interna
# Segundos de espera. Debe ser mayor que PRODUCTOS_TIMEOUT_MS de pedidos.
TIMEOUT_S=10
