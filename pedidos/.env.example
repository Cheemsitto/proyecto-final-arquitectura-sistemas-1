# Puerto del servicio de pedidos
PORT=8082

# Clave interna que debe enviar el broker (X-Service-Key)
SERVICE_KEY=cambia-esta-clave-interna

# Base de datos propia del servicio
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pedidos_db
DB_USER=root
DB_PASSWORD=
# PREFERRED en local, REQUIRED si el proveedor en la nube exige SSL
DB_SSL_MODE=PREFERRED
# update crea la tabla si no existe; validate solo revisa que coincida con el script SQL
DB_DDL_AUTO=update

# Servicio de productos
PRODUCTOS_URL=http://localhost:3001
PRODUCTOS_TIMEOUT_MS=3000
# Debe ser igual a SERVICE_KEY del servicio de productos
PRODUCTOS_SERVICE_KEY=cambia-esta-clave-interna
