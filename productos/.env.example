# Puerto del servicio de productos
PORT=3001

# Clave interna que deben enviar el broker y el servicio de pedidos (X-Service-Key)
SERVICE_KEY=cambia-esta-clave-interna

# Base de datos propia del servicio
DB_HOST=localhost
DB_PORT=3306
DB_NAME=productos_db
DB_USER=root
DB_PASSWORD=
# true si el proveedor en la nube exige SSL
DB_SSL=false
# Opcional: certificado CA del proveedor (contenido PEM) para verificar el servidor
# DB_SSL_CA=
# Crea la tabla al iniciar si no existe (true/false)
DB_SYNC=true
