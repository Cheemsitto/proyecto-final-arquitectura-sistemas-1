{
  "info": {
    "name": "Ecommerce - Proyecto final Arquitectura de Sistemas I",
    "description": "Todas las peticiones entran por el broker ({{broker_url}}). Ejecute las carpetas 01 a 05 en orden: el login guarda el token y las demás peticiones lo usan. La carpeta 06 necesita preparar el escenario antes (lea la descripción de cada petición).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "precioProducto",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "productoTemporalId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Autenticación",
      "item": [
        {
          "name": "Login correcto (guarda el token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{broker_url}}/auth/login",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test(\"Entrega un token bearer\", () => {",
                  "  pm.expect(datos.access_token).to.be.a(\"string\");",
                  "  pm.expect(datos.token_type).to.eql(\"bearer\");",
                  "});",
                  "pm.collectionVariables.set(\"token\", datos.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{broker_url}}/auth/login",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Trae un mensaje de error\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver usuario del token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{broker_url}}/auth/perfil",
              "host": [
                "{{broker_url}}"
              ],
              "path": [
                "auth",
                "perfil"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve el usuario\", () => pm.expect(pm.response.json().usuario).to.eql(pm.environment.get(\"usuario\") || pm.variables.get(\"usuario\")));"
                ]
              }
            }
          ]
        }
      ]
    },
